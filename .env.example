# DeepSeek 开放平台 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com）
# 用于 qwen-turbo / qwen-plus / wanx2.1-t2i-plus
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 演示模式：设为 true 时，未配置Key也能用预置数据跑通全部演示流程（断网兜底）
DEMO_FALLBACK=true

# 后端监听端口（部署时可覆盖）
PORT=3001

# 前端访问后端的地址；留空走 Vite 同源代理 /api；前后端分离部署时填完整域名
VITE_API_BASE=
